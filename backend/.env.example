# Postgres connection for SQLAlchemy (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/supplychain


# Simulation worker (optional overrides -- see backend/simulation/config.py)
# SIM_CYCLE_SECONDS=5
# SIM_DISRUPTION_RATE=0.05
# SIM_ENABLED=1

# Agent service -- runs on Groq's free tier (OpenAI-compatible API).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# AGENT_ENABLED=1
# AGENT_MODEL=llama-3.3-70b-versatile   # supports parallel tool calls
#   Alternatives: openai/gpt-oss-120b, openai/gpt-oss-20b -- strong, but Groq
#   documents them as NOT supporting parallel tool calls.
# AGENT_TEMPERATURE=0.3
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# AGENT_READ_ONLY=0          # 1 = agent may observe but not change anything
# AGENT_MIN_INTERVAL_SECONDS=20
# AGENT_HEARTBEAT_SECONDS=300
# AGENT_MEMORY=1                    # 0 = control condition: no past cases in prompt
# AGENT_MEMORY_CASES=4              # how many past cases to retrieve
# AGENT_OUTCOME_WINDOW_SECONDS=120  # how long before judging what came of a decision

# Alternate provider, used to run the memory A/B probe when Groq's free-tier
# daily quota is exhausted. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AGENT_PROVIDER=groq        # groq | gemini -- the main agent stays on groq
# AGENT_MODEL=               # defaults per provider (gpt-oss-120b / gemini-3.5-flash)
